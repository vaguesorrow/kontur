<div id="<%= dom_id article %>">
  <div>
    <strong>User:</strong>
    <%= article.user_id %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= article.title %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= article.body %>
  </div>

  <div>
    <strong>Cover url:</strong>
    <%= article.cover_url %>
  </div>

  <div>
    <strong>Published:</strong>
    <%= article.published %>
  </div>

</div>
